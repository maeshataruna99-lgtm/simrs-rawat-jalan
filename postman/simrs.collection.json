    {
      "name": "2. Master Data & Pasien Uji",
      "item": [
        {
          "name": "Ambil Jadwal Dokter DR001 Hari Senin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "const add = (8 - d.getDay()) % 7 || 7;",
                  "d.setDate(d.getDate() + add);",
                  "const iso = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('tgl_kunjungan', iso);",
                  "const sfx = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('nik_uji', '3279999999' + sfx);",
                  "pm.collectionVariables.set('run_sfx', sfx);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Jadwal 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().data;",
                  "const j = list.find(x => x.hari === 1 && x.dokter && x.dokter.kode === 'DR001') || list.find(x => x.hari === 1);",
                  "pm.test('Jadwal Senin ditemukan', () => pm.expect(j).to.be.an('object'));",
                  "pm.collectionVariables.set('jadwal_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": "{{yii_url}}/master/jadwal-dokter?per_page=100"
          }
