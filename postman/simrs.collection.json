      "name": "4. Billing, Pembayaran Bertahap, & Idempotency (D.3)",
      "item": [
        {
          "name": "Buat Invoice Kunjungan (4 Sumber)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invoice 201', () => pm.response.to.have.status(201));",
                  "const inv = pm.response.json().data;",
                  "pm.test('4 sumber biaya terkumpul', () => pm.expect(inv.items.length).to.eql(4));",
                  "const c1 = Math.floor(inv.total / 2);",
                  "const c2 = inv.total - c1;",
                  "pm.collectionVariables.set('invoice_id', inv.id);",
                  "pm.collectionVariables.set('cicilan_1', c1);",
                  "pm.collectionVariables.set('cicilan_2', c2);",
                  "pm.collectionVariables.set('idem_pay_1', 'newman-pay1-' + pm.collectionVariables.get('run_sfx'));",
                  "pm.collectionVariables.set('idem_pay_2', 'newman-pay2-' + pm.collectionVariables.get('run_sfx'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_kasir}}"
              }
            ],
            "url": "{{yii_url}}/transaction/invoice/{{kunjungan_id}}",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
