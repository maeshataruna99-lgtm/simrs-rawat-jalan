# Salin menjadi .env sebelum menjalankan docker compose.

# PostgreSQL
DB_NAME=simrs
DB_USER=simrs
DB_PASSWORD=simrs_dev
DB_PORT=5432

# Backend Yii
YII_DEBUG=true
YII_ENV=dev
CORS_ORIGIN=http://localhost:5173

# JWT: diterbitkan Yii, diverifikasi Yii dan Node dengan secret yang sama (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL=28800

# API key sistem eksternal (contoh: alat/sistem laboratorium) untuk endpoint integrasi Node, pisahkan dengan koma
LAB_API_KEYS=ganti-dengan-api-key-lab

# Password awal akun dummy hasil `php yii seed` (hanya untuk pengembangan)
SEED_PASSWORD=simrs123
