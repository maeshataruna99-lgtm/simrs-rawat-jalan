# Salin menjadi .env sebelum menjalankan docker compose.

# PostgreSQL
DB_NAME=simrs
DB_USER=simrs
DB_PASSWORD=simrs_dev
DB_PORT=5432

# Backend Yii
YII_DEBUG=true
YII_ENV=dev
CORS_ORIGIN=http://localhost:5173

# JWT: diterbitkan Yii, diverifikasi Yii dan Node dengan secret yang sama (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL=28800
