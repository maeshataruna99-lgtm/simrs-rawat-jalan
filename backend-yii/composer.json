{
    "name": "simrs/backend-yii",
    "description": "Backend utama SIMRS rawat jalan: business logic dan penulisan data.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.49"
    },
    "replace": {
        "bower-asset/jquery": "*",
        "bower-asset/inputmask": "*",
        "bower-asset/punycode": "*",
        "bower-asset/yii2-pjax": "*"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
