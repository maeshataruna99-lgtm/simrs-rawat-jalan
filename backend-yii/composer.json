{
    "name": "simrs/backend-yii",
    "description": "Backend utama SIMRS rawat jalan: business logic dan penulisan data.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "yiisoft/yii2": "~2.0.49"
    },
    "replace": {
        "bower-asset/jquery": "*",
        "bower-asset/inputmask": "*",
        "bower-asset/punycode": "*",
        "bower-asset/yii2-pjax": "*"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "test": [
            "DB_NAME=simrs_test php yii migrate --interactive=0",
            "phpunit"
        ]
    }
}
